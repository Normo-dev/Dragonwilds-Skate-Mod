+            .static_edges
+            .iter()
+            .filter(|edge| {
+                let min = lanes(edge.local_bounds.min);
+                let max = lanes(edge.local_bounds.max);
+                (0..3).all(|i| center[i] - extent[i] <= max[i] && min[i] <= center[i] + extent[i])
+            })
+            .take(40)
+            .map(|edge| [lanes(edge.start), lanes(edge.end)])
+            .collect()
