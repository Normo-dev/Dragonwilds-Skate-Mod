+                min:std::array::from_fn(|axis|raw.iter().map(|p|p[axis]).fold(f64::INFINITY,f64::min)),
+                max:std::array::from_fn(|axis|raw.iter().map(|p|p[axis]).fold(f64::NEG_INFINITY,f64::max)),
+            };
