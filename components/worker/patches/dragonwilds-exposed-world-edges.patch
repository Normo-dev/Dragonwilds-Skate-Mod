+}
+fn bits(rails: &[Vec<[f32; 3]>]) -> Vec<Vec<[u32; 3]>> {
+    rails
+        .iter()
+        .map(|r| r.iter().map(|p| p.map(f32::to_bits)).collect())
+        .collect()
+}
+fn hash(bytes: &[u8]) -> String {
+    Sha256::digest(bytes)
+        .iter()
+        .map(|v| format!("{v:02x}"))
+        .collect()
+}
+fn rehash(bytes: &mut [u8]) {
+    let digest = Sha256::digest(&bytes[128..]);
+    bytes[96..128].copy_from_slice(&digest);
+}
