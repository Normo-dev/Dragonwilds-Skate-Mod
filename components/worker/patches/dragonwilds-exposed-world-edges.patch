+            ((index + base.map_or(0, |b| b.counts.geometry_triangles / 12)) as u32).to_le_bytes(),
+        );
+        instances.extend((index as u32).to_le_bytes());
+        for row in [[1f64, 0., 0.], [0., 1., 0.], [0., 0., 1.]] {
+            for v in row {
+                instances.extend(v.to_le_bytes());
+            }
+        }
+        for v in [0f64; 3] {
+            instances.extend(v.to_le_bytes());
+        }
