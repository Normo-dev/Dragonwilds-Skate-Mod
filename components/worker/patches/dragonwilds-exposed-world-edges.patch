+    assert!(warm.ready);
+    assert!(warm.cache_hit);
+    assert_eq!(warm.sha256, record.sha256);
+    assert_eq!(warm.bytes, record.bytes);
+    assert_eq!(warm.path, record.path);
+    assert_eq!(
+        record.path,
+        f.root
+            .join("native-rails")
+            .join(format!("{}.dwr1", f.snapshot.manifest_sha256))
