+                let y = (i * 11 % 23) as f32 * 0.1 - 1.;
+                rail(i, [x, y, -1.], [x + 0.2, y, 1.])
+            })
+            .collect();
+        let legacy = StaticProvider::authored(&rails).unwrap();
+        let mut dense = StaticProvider::authored(&rails).unwrap();
+        dense.enable_dense_authored().unwrap();
