+            }
+            if ranked_contact && !full_contact {
+                ranked_spurious.push(json!({"primitive":index,"fraction":fraction,"point":c}));
+            }
+            if full_contact {
+                valid += 1;
+                let local: Vec<_> = ids.iter().map(|&i| provider.primitives()[i]).collect();
