+        || points > max_points
+        || points < count.checked_mul(2).ok_or("Merged minimum overflow")?
+        || size != expected
+    {
+        return Err("Invalid merged rail count/size".into());
+    }
+    let mut hash = blake3::Hasher::new();
+    hash.update(&header[..56]);
