+                        origin[a] + direction[a] * x + axis[a] * y + normal[a] * z
+                    });
+                }
+                tris.push(t);
+            }
+            assert_eq!(
+                bits(reference(
+                    &tris, origin, direction, axis, half, thickness, len, pad
+                )),
+                bits(intervals(
+                    &tris, origin, direction, axis, half, thickness, len, pad
+                )),
+                "case{i}"
+            );
+        }
+    }
+}
