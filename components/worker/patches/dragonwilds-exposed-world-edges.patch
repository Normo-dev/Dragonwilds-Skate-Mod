+    );
+    assert_eq!(
+        expected,
+        close(
+            &mut snapshot,
+            vec![Segment { a: b.b, b: b.a }, Segment { a: a.b, b: a.a }]
+        )
+    );
+    let gap = Segment {
+        a: [100_001., 180_000., 300.],
+        ..b
+    };
+    assert_eq!(
+        close(&mut snapshot, vec![a, gap]).len(),
+        2,
+        "one centimetre unsupported gap must remain a gap"
+    );
+    let collapsed = Segment {
+        a: b.a,
+        b: [100_000.00000002, 180_000., 300.],
+    };
