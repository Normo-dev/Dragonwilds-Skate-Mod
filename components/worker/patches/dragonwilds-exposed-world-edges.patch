+    let close = |snap: &mut Snapshot, input: Vec<Segment>| {
+        snap.manifest.segments = input.len();
+        snap.cells = vec![Arc::new(input)];
+        bits(snap)
+    };
+    let expected = close(&mut snapshot, vec![a, b]);
