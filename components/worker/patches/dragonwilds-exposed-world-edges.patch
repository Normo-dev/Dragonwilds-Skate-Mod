+fn cell(p: [f64; 3]) -> ([i32; 3], Bounds) {
+    let key = p.map(|v| (v / 3200.).floor() as i32);
+    (
+        key,
+        Bounds {
+            min: key.map(|v| v as f64 * 3200.),
+            max: key.map(|v| (v as f64 + 1.) * 3200.),
+        },
+    )
