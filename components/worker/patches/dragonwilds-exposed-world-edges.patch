+                f64::from_le_bytes(row[i * 8..i * 8 + 8].try_into().unwrap())
+            });
+            if p.iter().any(|v| !v.is_finite()) {
+                return Err("Non-finite DWC1 endpoint".into());
+            }
+            let segment = Segment {
+                a: [p[0], p[1], p[2]],
+                b: [p[3], p[4], p[5]],
