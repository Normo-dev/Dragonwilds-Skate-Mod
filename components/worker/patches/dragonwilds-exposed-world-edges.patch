+fn hex(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+fn folder(scene: &Path) -> Result<PathBuf, String> {
+    Ok(scene
+        .parent()
+        .and_then(Path::parent)
+        .ok_or("Scene manifest has no cache parent")?
+        .join("accepted-scene-cache"))
