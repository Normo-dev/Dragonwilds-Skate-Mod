+struct StoredSource(BoardWorld);
+impl geometry_source::WorldGeometry for StoredSource {
+    fn validate(&self) -> Result<(), &'static str> { self.0.query_metadata().map(|_| ()) }
+    fn triangle_count(&self) -> usize { self.0.triangle_count() }
+    fn metadata(&self) -> &QueryMetadata { self.0.query_metadata().unwrap() }
+    fn triangle(&self, index: usize, _: RetailContactMaterial) -> Option<WorldTriangle> { self.0.triangle(index) }
+    fn triangle_bounds(&self, index: usize) -> Bounds { self.0.triangle_bounds(index) }
+    fn packed_surface(&self, index: usize) -> u16 { self.0.packed_surface(index).unwrap() }
+    fn candidate_ranges(&self, bounds: Option<Bounds>) -> Vec<std::ops::Range<usize>> {
+        match bounds {
+            Some(b) => self.0.query_index.query(b, &self.metadata().meshes).into_iter()
+                .map(|i| self.metadata().meshes[i].triangle_range.clone()).collect(),
+            None => vec![0..self.triangle_count()],
+        }
+    }
+    fn candidate_mesh_indices(&self, bounds: Option<Bounds>) -> Vec<usize> {
+        bounds.map_or_else(|| (0..self.metadata().meshes.len()).collect(), |b|
+            self.0.query_index.query(b, &self.metadata().meshes))
+    }
+    fn maximum_fatness(&self) -> f32 { self.0.maximum_fatness }
+    fn maximum_triangle_margin(&self) -> f32 { self.0.maximum_triangle_margin }
+}
+fn sourced(triangles: Vec<WorldTriangle>) -> BoardWorld {
+    BoardWorld::from_source(std::sync::Arc::new(StoredSource(annotated(triangles))), material()).unwrap()
+}
