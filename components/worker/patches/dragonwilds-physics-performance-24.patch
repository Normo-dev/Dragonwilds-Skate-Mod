+impl Drop for Temp {
+    fn drop(&mut self) {
+        let path = self.0.canonicalize().unwrap();
+        assert!(path.starts_with(std::env::temp_dir().canonicalize().unwrap()));
+        assert!(
+            path.file_name()
+                .unwrap()
+                .to_str()
+                .unwrap()
+                .starts_with("dws-grind-index-")
+        );
+        std::fs::remove_dir_all(path).unwrap();
