+            return None;
+        }
+        covered = covered.max(hi);
+    }
+    if covered < 0.06 - 1e-7
+        || !behind.is_finite()
+        || !ahead.is_finite()
+        || high - low > 0.04
+        || high.abs() > 0.002
+    {
+        return None;
+    }
+    Some(Proof {
+        direction,
+        up,
+        low,
+        high,
+    })
