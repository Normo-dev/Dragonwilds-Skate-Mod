+pub fn extent(point: V, center: V, radius: f64, deck: V, side: V) -> Option<f64> {
+    if !radius.is_finite()
+        || radius < 0.
+        || point
+            .into_iter()
+            .chain(center)
+            .chain(deck)
+            .chain(side)
+            .any(|v| !v.is_finite())
