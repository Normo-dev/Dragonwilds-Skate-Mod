+        return None;
+    }
+    // Match the existing locality padding, including authored collider fatness.
+    let delta = sub(point, center);
+    if dot(delta, delta) > (radius + 0.04).powi(2) {
+        return None;
+    }
+    Some(dot(sub(point, deck), side).abs())
