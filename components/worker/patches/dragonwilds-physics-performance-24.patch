+pub struct Transaction {
+    pub delta: GraphDelta,
+    pub stats: UpdateStats,
+    serial: u64,
+    previous_identity: String,
+    undo: Vec<(CellKey, Option<StagedCell>)>,
+    old_rails: BTreeMap<EdgeKey, Rail>,
+    next_owner: u64,
+    census: Census,
+    replacements: Vec<(CellKey, Option<StagedCell>)>,
