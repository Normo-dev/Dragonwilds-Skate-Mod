+fn cube(lo: [f64; 3], hi: [f64; 3]) -> Vec<Tri> {
+    let p: Vec<_> = (0..8)
+        .map(|n| std::array::from_fn(|i| if n & (1 << i) == 0 { lo[i] } else { hi[i] }))
+        .collect();
