+            poly = clip(poly, axis, bound, less);
+            if poly.is_empty() {
+                break;
+            }
+        }
+        if poly.is_empty() {
+            continue;
+        }
+        let lo = poly.iter().map(|p| p[0]).fold(f64::INFINITY, f64::min);
