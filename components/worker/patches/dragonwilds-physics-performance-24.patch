+                self.edges[id as usize] = Some(edge);
+                id
+            } else {
+                let id = self.edges.len() as u32;
+                self.edges.push(Some(edge));
+                id
+            };
+            self.lookup.insert(key, id);
+            candidates.push(id);
+            for at in key {
+                self.nodes
+                    .entry(at)
+                    .and_modify(|around| around.push(id))
